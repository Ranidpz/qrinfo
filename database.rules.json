{
  "rules": {
    "qhunt": {
      "$codeId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['status', 'lastUpdated']) && newData.child('status').val() === 'registration'",
        "stats": {
          "$stat": {
            ".validate": "newData.isNumber() && ($stat === 'lastUpdated' || newData.val() === 0)"
          }
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "qstage": {
      "$codeId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['status', 'lastUpdated']) && newData.child('status').val() === 'standby'",
        "stats": {
          "$stat": {
            ".validate": "newData.isNumber() && ($stat === 'lastUpdated' || newData.val() === 0)"
          }
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "qchallenge": {
      "$codeId": {
        ".read": true,
        ".write": false
      }
    },
    "qtreasure": {
      "$codeId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['status', 'lastUpdated']) && newData.child('status').val() === 'registration'",
        "stats": {
          "$stat": {
            ".validate": "newData.isNumber() && ($stat === 'lastUpdated' || newData.val() === 0)"
          }
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "qgames": {
      "$codeId": {
        ".read": true,
        "stats": {
          ".write": true
        },
        "queue": {
          ".write": true
        },
        "matches": {
          ".write": true
        },
        "memoryRooms": {
          ".write": true
        },
        "froggerRooms": {
          ".write": true
        },
        "viewers": {
          ".write": true,
          ".indexOn": [
            "joinedAt"
          ]
        },
        "chat": {
          ".write": true,
          ".indexOn": [
            "sentAt"
          ],
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderNickname', 'text', 'sentAt', 'phraseType']) && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('senderNickname').isString() && newData.child('senderNickname').val().length <= 30 && newData.child('senderId').isString() && newData.child('sentAt').isNumber() && newData.child('phraseType').isString()"
          }
        },
        "chatBans": {
          ".write": true,
          "$visitorId": {
            ".validate": "newData.hasChildren(['visitorId', 'bannedAt']) && newData.child('bannedAt').isNumber() && newData.child('visitorId').isString() && newData.child('visitorId').val().length <= 50"
          }
        }
      }
    }
  }
}
